-- Función ULTRA ESTRICTA para verificar si TÚ mataste al jugador
local function didLocalPlayerKill(victim)
    if not victim or not victim.Character then return false end
    
    local hum = victim.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    -- Método 1: Verificar la etiqueta "creator" (la más confiable)
    local creatorTag = hum:FindFirstChild("creator")
    if creatorTag and creatorTag:IsA("ObjectValue") and creatorTag.Value == LocalPlayer then
        return true
    end
    
    -- Método 2: Verificar si le hicimos daño en los últimos 1.5 segundos
    local lastHit = myLastHitTime[victim]
    if lastHit and (tick() - lastHit) <= 1.5 then
        return true
    end
    
    -- Método 3: Verificar si el daño que hicimos fue significativo (más del 50% de su vida)
    local damage = myDamageDealt[victim] or 0
    if damage > (hum.MaxHealth * 0.5) then
        return true
    end
    
    return false
end

-- Función para rastrear SOLO el daño que TÚ haces personalmente
local function setupDamageTracker(player)
    if player == LocalPlayer then return end
    
    myKillTracker[player] = false
    myLastHitTime[player] = 0
    myDamageDealt[player] = 0
    
    local function onCharacterAdded(char)
        myKillTracker[player] = false
        myLastHitTime[player] = 0
        myDamageDealt[player] = 0
        
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        
        local lastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth < lastHealth then
                local damage = lastHealth - newHealth
                if damage > 0 then
                    -- SOLO registrar daño si estamos disparando activamente
                    local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    if isShooting then
                        myDamageDealt[player] = myDamageDealt[player] + damage
                        myLastHitTime[player] = tick()
                    end
                end
            end
            lastHealth = newHealth
            
            -- Cuando el jugador muere
            if newHealth <= 0 and lastHealth > 0 and not myKillTracker[player] then
                myKillTracker[player] = true
                -- SOLO reproducir si TÚ lo mataste
                if didLocalPlayerKill(player) then
                    playKillSound()
                end
            end
        end)
        
        hum.Died:Connect(function()
            if not myKillTracker[player] then
                myKillTracker[player] = true
                -- SOLO reproducir si TÚ lo mataste
                if didLocalPlayerKill(player) then
                    playKillSound()
                end
            end
        end)
    end
    
    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

