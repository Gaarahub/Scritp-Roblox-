local function playKillSound()
    if getgenv().KillSoundEnabled and soundInstance and getgenv().SelectedKillSound then
        soundInstance.SoundId = "rbxassetid://" .. tostring(getgenv().SelectedKillSound)
        soundInstance:Play()
        pcall(function()
            if UserInputService.TouchEnabled then
                UserInputService:SetVibration(Enum.VibrationMotor.Medium, 0.5)
            end
        end)
    end
end

local function didLocalPlayerKill(victim)
    if not victim or not victim.Character then return false end
    
    local hum = victim.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    local creatorTag = hum:FindFirstChild("creator")
    if creatorTag and creatorTag:IsA("ObjectValue") and creatorTag.Value == LocalPlayer then
        return true
    end
    
    local lastHit = myLastHitTime[victim]
    if lastHit and (tick() - lastHit) <= 1.5 then
        return true
    end
    
    local damage = myDamageDealt[victim] or 0
    if damage > (hum.MaxHealth * 0.5) then
        return true
    end
    
    return false
end

local function setupDamageTracker(player)
    if player == LocalPlayer then return end
    
    myKillTracker[player] = false
    myLastHitTime[player] = 0
    myDamageDealt[player] = 0
    
    local function onCharacterAdded(char)
        myKillTracker[player] = false
        myLastHitTime[player] = 0
        myDamageDealt[player] = 0
        
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        
        local lastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth < lastHealth then
                local damage = lastHealth - newHealth
                if damage > 0 then
                    local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    if isShooting then
                        myDamageDealt[player] = myDamageDealt[player] + damage
                        myLastHitTime[player] = tick()
                    end
                end
            end
            lastHealth = newHealth
            
            if newHealth <= 0 and lastHealth > 0 and not myKillTracker[player] then
                myKillTracker[player] = true
                if didLocalPlayerKill(player) then
                    playKillSound()
                end
            end
        end)
        
        hum.Died:Connect(function()
            if not myKillTracker[player] then
                myKillTracker[player] = true
                if didLocalPlayerKill(player) then
                    playKillSound()
                end
            end
        end)
    end
    
    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then setupDamageTracker(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then setupDamageTracker(p) end
end)

Players.PlayerRemoving:Connect(function(p)
    myKillTracker[p] = nil
    myLastHitTime[p] = nil
    myDamageDealt[p] = nil
end)

-- =====================================================
--  NUEVO TEAM CHECK ULTRA-ESTRICTO (A MI MANERA)
-- =====================================================

function isTeammate(player)
    if player == LocalPlayer then return true end
    if not getgenv().TeamCheckEnabled then return false end
    
    -- Método 1: Comparar Teams directamente
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team == player.Team then
            return true
        end
    end
    
    -- Método 2: Comparar TeamColor
    if LocalPlayer.TeamColor and player.TeamColor then
        if LocalPlayer.TeamColor == player.TeamColor then
            return true
        end
    end
    
    -- Método 3: Verificar si están en el mismo grupo (si aplica)
    if LocalPlayer:IsInGroup(player.UserId) then
        return true
    end
    
    -- Método 4: Verificar si tienen el mismo nombre de equipo en el Character
    local lpChar = LocalPlayer.Character
    local pChar = player.Character
    if lpChar and pChar then
        local lpTeam = lpChar:FindFirstChild("Team")
        local pTeam = pChar:FindFirstChild("Team")
        if lpTeam and pTeam and lpTeam.Value == pTeam.Value then
            return true
        end
    end
    
    -- Método 5: Verificar si el color de su ropa es similar (para juegos sin sistema de equipos)
    if lpChar and pChar then
        local lpShirt = lpChar:FindFirstChildOfClass("Shirt")
        local pShirt = pChar:FindFirstChildOfClass("Shirt")
        if lpShirt and pShirt then
            local lpColor = lpShirt.Color
            local pColor = pShirt.Color
            if lpColor and pColor then
                local diff = (lpColor.R - pColor.R)^2 + (lpColor.G - pColor.G)^2 + (lpColor.B - pColor.B)^2
                if diff < 0.1 then
                    return true
                end
            end
        end
    end
    
    return false
end

function getTeamColor(player)
    if isTeammate(player) then
        return Color3.fromRGB(0, 255, 0)
    else
        return Color3.fromRGB(255, 0, 0)
    end
end

-- =====================================================
--  SISTEMA DE VISIBILIDAD REAL PARA TRIGGERBOT (A MI MANERA)
-- =====================================================

function isEnemyVisible(player)
    if not player or not player.Character then return false end
    
    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if not hrp or not hum or hum.Health <= 0 then return false end
    
    local camPos = Camera.CFrame.Position
    
    local targetPart = head or hrp
    local targetPos = targetPart.Position
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    params.IgnoreWater = true
    
    local raycastResult = workspace:Raycast(camPos, (targetPos - camPos).Unit * (targetPos - camPos).Magnitude, params)
    
    if not raycastResult then
        return true
    end
    
    local hitPart = raycastResult.Instance
    if hitPart and hitPart:IsDescendantOf(char) then
        return true
    end
    
    return false
end

function isCursorOnVisibleEnemy()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    
    if not target then return false end
    
    local enemyPlayer = Players:GetPlayerFromCharacter(target.Parent) or Players:GetPlayerFromCharacter(target.Parent.Parent)
    
    if not enemyPlayer or enemyPlayer == LocalPlayer then return false end
    if isTeammate(enemyPlayer) then return false end
    
    if not isEnemyVisible(enemyPlayer) then return false end
    
    local hum = enemyPlayer.Character and enemyPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    return true
end

