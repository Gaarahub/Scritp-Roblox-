local function scanAndSkin(container)
if not container then return end
for _, item in ipairs(container:GetChildren()) do
if item:IsA("Tool") then
if getgenv().InfAmmoEnabled or getgenv().RapidFireEnabled then
for _, desc in ipairs(item:GetDescendants()) do
if desc:IsA("NumberValue") or desc:IsA("IntValue") then
local name = desc.Name:lower()
if getgenv().RapidFireEnabled and (name:find("cooldown") or name:find("firerate")) then
desc.Value = 0.01
end
if getgenv().InfAmmoEnabled and (name:find("ammo") or name:find("clip")) then
desc.Value = 999
end
end
end
end

if not originalWeaponStates[item] then
originalWeaponStates[item] = {}
if item:IsA("BasePart") then
originalWeaponStates[item][item] = {
Color = item.Color,
Material = item.Material,
TextureID = item:IsA("MeshPart") and item.TextureID or ""
}
end
for _, part in ipairs(item:GetDescendants()) do
if part:IsA("BasePart") then
originalWeaponStates[item][part] = {
Color = part.Color,
Material = part.Material,
TextureID = part:IsA("MeshPart") and part.TextureID or ""
}
end
end
end

if getgenv().SkinPatternEnabled then
local patternData = patternConfigs[getgenv().SelectedWeaponPattern] or patternConfigs["Galaxy"]
local function applyPattern(p)
if p:IsA("MeshPart") then p.TextureID = "" end
local sa = p:FindFirstChildOfClass("SurfaceAppearance")
if sa then sa:Destroy() end
p.Color = patternData.color
p.Material = patternData.material
end
if item:IsA("BasePart") then applyPattern(item) end
