-- Sistema real de Stretched Screen por matriz de cámara
local Camera = workspace.CurrentCamera
game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        if getgenv().StretchEnabled then
            local res = getgenv().StretchResolution or 0.75
            Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, res, 0, 0, 0, 1)
        end
    end)
end)

local originalSizes = {}
local originalTransparencies = {}

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character then
                local char = p.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local parts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
                    for _, partName in ipairs(parts) do
                        local part = char:FindFirstChild(partName)
                        if part and part:IsA("BasePart") then
                            if not originalSizes[part] then
                                originalSizes[part] = part.Size
                                originalTransparencies[part] = part.Transparency
                            end
                            if getgenv().HitboxEnabled then
                                part.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                part.CanCollide = false
                                part.Transparency = getgenv().HitboxTransparency
                                part.Color = getgenv().HitboxColor
                                part.Material = Enum.Material.Neon
                            else
                                part.Material = Enum.Material.Plastic
                                if originalSizes[part] then part.Size = originalSizes[part] end
                                if originalTransparencies[part] then part.Transparency = originalTransparencies[part] end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

-- Tracers Naturales (Fluidos que acompañan el movimiento de la cámara desde arriba)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        local camCF = Camera.CFrame
        local dynamicTopOrigin = camCF.Position + (camCF.LookVector * 1.5) + (camCF.UpVector * 3.5)

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local tracerPart = char:FindFirstChild("1AN_TracerPart")
                
                if getgenv().TracersEnabled and hrp and hum and hum.Health > 0 then
                    if not tracerPart then
                        tracerPart = Instance.new("Part")
                        tracerPart.Name = "1AN_TracerPart"
                        tracerPart.Anchored = true
                        tracerPart.CanCollide = false
                        tracerPart.CastShadow = false
                        tracerPart.Material = Enum.Material.Neon
                        tracerPart.Color = Color3.fromRGB(138, 43, 226)
                        tracerPart.Transparency = 0.35
                        tracerPart.Parent = char
                    end
                    
                    local p1 = dynamicTopOrigin
                    local p2 = hrp.Position
                    local distance = (p1 - p2).Magnitude
                    
                    tracerPart.Size = Vector3.new(0.05, 0.05, distance)
                    tracerPart.CFrame = CFrame.new(p1, p2) * CFrame.new(0, 0, -distance / 2)
                    tracerPart.Transparency = 0.3
                else
                    if tracerPart then
                        tracerPart:Destroy()
                    end
                end
            end
        end
    end)
end)

