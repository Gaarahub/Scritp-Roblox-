            if UserInputService.TouchEnabled then
                UserInputService:SetVibration(Enum.VibrationMotor.Medium, 0.5)
            end
        end)
    end
end

-- Función para verificar si el LocalPlayer mató al jugador
local function didLocalPlayerKill(victim)
    if not victim or not victim.Character then return false end
    
    local hum = victim.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    -- Método 1: Verificar la etiqueta "creator" (si el juego la usa)
    local creatorTag = hum:FindFirstChild("creator")
    if creatorTag and creatorTag:IsA("ObjectValue") and creatorTag.Value == LocalPlayer then
        return true
    end
    
    -- Método 2: Verificar si le hicimos daño en los últimos 5 segundos
    local lastHit = playerLastHitTime[victim]
    if lastHit and (tick() - lastHit) <= 5 then
        return true
    end
    
    -- Método 3: Verificar si estamos apuntando a él cuando muere (móvil-friendly)
    if victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = victim.Character.HumanoidRootPart
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local mousePos = UserInputService:GetMouseLocation()
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if dist < 100 then -- Si el cursor está cerca del enemigo
                return true
            end
        end
    end
    
    -- Método 4: Si el arma está equipada y apuntando al enemigo
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                local ray = Ray.new(Camera.CFrame.Position, Camera.CFrame.LookVector * 200)
                local hitPart = workspace:Raycast(ray.Origin, ray.Direction)
                if hitPart and hitPart.Instance then
                    local hitPlayer = Players:GetPlayerFromCharacter(hitPart.Instance.Parent) or Players:GetPlayerFromCharacter(hitPart.Instance.Parent.Parent)
                    if hitPlayer == victim then
                        return true
                    end
                end
            end
        end
    end
    
    return false
end

-- Función para rastrear daño hecho a cada jugador
local function setupDamageTracker(player)
    if player == LocalPlayer then return end
    
    playerDamageTracker[player] = 0
    playerLastHitTime[player] = 0
    playerIsDead[player] = false
    
    local function onCharacterAdded(char)
        playerIsDead[player] = false
        playerDamageTracker[player] = 0
        playerLastHitTime[player] = 0
        
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        
        -- Rastrear cambios de salud para detectar daño
        local lastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth < lastHealth then
                local damage = lastHealth - newHealth
                -- Si el daño fue reciente y estamos apuntando al jugador, probablemente fuimos nosotros
                if damage > 0 then
                    -- Verificar si estamos disparando (mouse presionado)
                    local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    if isShooting or getgenv().TriggerbotEnabled then
                        playerDamageTracker[player] = playerDamageTracker[player] + damage
                        playerLastHitTime[player] = tick()
                    end
                end
            end
            lastHealth = newHealth
            
            -- Detectar muerte
            if newHealth <= 0 and lastHealth > 0 and not playerIsDead[player] then
                playerIsDead[player] = true
                if didLocalPlayerKill(player) then
                    playKillSound()
                end
            end
        end)
        
        -- También detectar muerte por Died
        hum.Died:Connect(function()
            if not playerIsDead[player] then
                playerIsDead[player] = true
                if didLocalPlayerKill(player) then
                    playKillSound()
                end
            end
        end)
    end
    
    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

