function ApplyRealStretch()
    if stretchConnection then stretchConnection:Disconnect() end
    stretchConnection = RunService.RenderStepped:Connect(function()
        if getgenv().StretchedEnabled and workspace.CurrentCamera then
            local cam = workspace.CurrentCamera
            cam.CFrame = cam.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, getgenv().StretchedIntensity or 0.75, 0, 0, 0, 1)
        end
    end)
end

