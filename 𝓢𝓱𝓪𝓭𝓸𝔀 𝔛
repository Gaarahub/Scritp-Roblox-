local function cleanAudioId(audioId)
    if audioId == nil then return "" end
    return tostring(audioId):gsub("%D", "")
end

local function stopMusic()
    if soundInstance and soundInstance.Parent then
        soundInstance:Stop()
        soundInstance.TimePosition = 0
    end
end

local function playMusic(audioId)
    local cleanId = cleanAudioId(audioId)
    if cleanId == "" then return false end
    stopMusic()
    soundInstance.SoundId = "rbxassetid://" .. cleanId
    local ok, err = pcall(function() soundInstance:Play() end)
    if not ok then
        warn("Error reproduciendo audio: " .. tostring(err))
        return false
    end
    return true
end

