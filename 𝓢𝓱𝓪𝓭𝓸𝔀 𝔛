local function ApplyDarkBlueTheme()
    pcall(function()
        -- Colores del tema
        local bgColor = Color3.fromRGB(8, 12, 25)        -- Fondo principal azul muy oscuro
        local bgColor2 = Color3.fromRGB(12, 18, 35)      -- Fondo secundario
        local bgColor3 = Color3.fromRGB(16, 24, 45)      -- Fondo terciario
        local accentColor = Color3.fromRGB(30, 60, 120)  -- Acento azul
        local accentColor2 = Color3.fromRGB(50, 100, 200) -- Acento azul claro
        local textColor = Color3.fromRGB(200, 220, 255)  -- Texto azul claro
        local textColor2 = Color3.fromRGB(150, 180, 230) -- Texto azul medio
        local borderColor = Color3.fromRGB(40, 80, 160)   -- Bordes azules
        
        -- Recorrer TODOS los elementos del CoreGui
        for _, gui in ipairs(CoreGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, descendant in ipairs(gui:GetDescendants()) do
                    -- Frames (fondos)
                    if descendant:IsA("Frame") then
                        descendant.BackgroundColor3 = bgColor
                    end
                    
                    -- ScrollingFrames
                    if descendant:IsA("ScrollingFrame") then
                        descendant.BackgroundColor3 = bgColor
                        descendant.ScrollBarImageColor3 = accentColor
                    end
                    
                    -- TextLabels y TextButtons
                    if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                        descendant.TextColor3 = textColor
                        if descendant:IsA("TextButton") then
                            descendant.BackgroundColor3 = bgColor2
                        end
                    end
                    
                    -- TextBoxes
                    if descendant:IsA("TextBox") then
                        descendant.TextColor3 = textColor
                        descendant.BackgroundColor3 = bgColor2
                        descendant.PlaceholderColor3 = textColor2
                    end
                    
                    -- UIStroke (bordes)
                    if descendant:IsA("UIStroke") then
                        descendant.Color = borderColor
                    end
                    
                    -- ImageLabels (iconos)
                    if descendant:IsA("ImageLabel") then
                        descendant.BackgroundColor3 = bgColor2
                    end
                    
                    -- ImageButtons
                    if descendant:IsA("ImageButton") then
                        descendant.BackgroundColor3 = bgColor2
                    end
                    
                    -- Sliders
                    if descendant:IsA("Slider") or descendant.Name:lower():find("slider") then
                        descendant.BackgroundColor3 = bgColor2
                    end
                    
                    -- Toggles
                    if descendant:IsA("TextButton") and (descendant.Name:lower():find("toggle") or descendant.Name:lower():find("check")) then
                        descendant.BackgroundColor3 = bgColor2
                    end
                    
                    -- Dropdowns
                    if descendant:IsA("TextButton") and descendant.Name:lower():find("dropdown") then
                        descendant.BackgroundColor3 = bgColor2
                    end
                end
            end
        end
        
        -- También aplicar al PlayerGui (para el botón de reabrir)
        for _, gui in ipairs(LocalPlayer:WaitForChild("PlayerGui"):GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, descendant in ipairs(gui:GetDescendants()) do
                    if descendant:IsA("Frame") then
                        descendant.BackgroundColor3 = bgColor
                    end
                    if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                        descendant.TextColor3 = textColor
                        if descendant:IsA("TextButton") then
                            descendant.BackgroundColor3 = bgColor2
                        end
                    end
                    if descendant:IsA("UIStroke") then
                        descendant.Color = borderColor
                    end
                end
            end
        end
    end)
end

