-- Función para actualizar los dibujos ESP
local function updateESP()
    if not getgenv().ESPEnabled then return end
    
    local camera = workspace.CurrentCamera
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            
            if hum and hum.Health > 0 and hrp and head then
                -- Crear dibujos si no existen
                createESPDrawings(player)
                local drawings = espObjects[player]
                
                -- Determinar color (rojo para enemigos, verde para aliados)
                local color = getTeamColor(player)
                
                -- Obtener posición en pantalla
                local headPos, headOnScreen = camera:WorldToViewportPoint(head.Position)
                local rootPos, rootOnScreen = camera:WorldToViewportPoint(hrp.Position)
                
                if headOnScreen and rootOnScreen then
                    -- Calcular altura y anchura de la caja
                    local height = math.abs(headPos.Y - rootPos.Y) * 2
                    local width = height * 0.6
                    
                    -- Actualizar caja
                    if getgenv().ESPBoxEnabled then
                        drawings.Box.Visible = true
                        drawings.Box.Color = color
                        drawings.Box.Thickness = getgenv().ESPThickness
                        drawings.Box.Position = Vector2.new(rootPos.X - width/2, rootPos.Y - height/2)
                        drawings.Box.Size = Vector2.new(width, height)
                    else
                        drawings.Box.Visible = false
                    end
                    
                    -- Actualizar línea
                    if getgenv().ESPLineEnabled then
                        drawings.Line.Visible = true
                        drawings.Line.Color = color
                        drawings.Line.Thickness = getgenv().ESPThickness
                        drawings.Line.From = screenCenter
                        drawings.Line.To = Vector2.new(rootPos.X, rootPos.Y)
                    else
                        drawings.Line.Visible = false
                    end
                    
                    -- Actualizar nombre
                    if getgenv().ESPNameEnabled then
                        drawings.Name.Visible = true
                        drawings.Name.Text = player.Name
                        drawings.Name.Color = color
                        drawings.Name.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 20)
                    else
                        drawings.Name.Visible = false
                    end
                    
                    -- Actualizar salud
                    if getgenv().ESPHealthEnabled then
                        drawings.Health.Visible = true
                        local healthPercent = math.floor((hum.Health / hum.MaxHealth) * 100)
                        drawings.Health.Text = tostring(healthPercent) .. "%"
                        drawings.Health.Color = Color3.fromRGB(0, 255, 0)
                        drawings.Health.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 5)
                    else
                        drawings.Health.Visible = false
                    end
                    
                    -- Actualizar distancia
                    if getgenv().ESPDistanceEnabled then
                        drawings.Distance.Visible = true
                        local dist = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
                        drawings.Distance.Text = tostring(dist) .. "m"
                        drawings.Distance.Color = color
                        drawings.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + height/2 + 5)
                    else
                        drawings.Distance.Visible = false
                    end
                else
                    -- Ocultar todos los dibujos si no está en pantalla
                    for _, drawing in pairs(drawings) do
                        drawing.Visible = false
                    end
                end
            else
                -- Ocultar todos los dibujos si el jugador no es válido
                if espObjects[player] then
                    for _, drawing in pairs(espObjects[player]) do
                        drawing.Visible = false
                    end
                end
            end
        end
    end
end

