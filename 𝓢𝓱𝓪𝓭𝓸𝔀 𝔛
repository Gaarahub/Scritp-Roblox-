-- Tarea para Rapid Fire, No Recoil y Fast Reload en armas
task.spawn(function()
    while true do
        task.wait(0.2)
        pcall(function()
            local player = game.Players.LocalPlayer
            if player.Character then
                for _, tool in ipairs(player.Character:GetChildren()) do
                    if tool:IsA("Tool") then
                        for _, v in ipairs(tool:GetDescendants()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local name = v.Name:lower()
                                if getgenv().RapidFireEnabled then
                                    if name:find("firerate") or name:find("cooldown") or name:find("delay") then
                                        v.Value = 0.01
                                    end
                                end
                                if getgenv().NoRecoilEnabled then
                                    if name:find("recoil") or name:find("spread") or name:find("kick") or name:find("shake") or name:find("accuracy") then
                                        v.Value = 0
                                    end
                                end
                                if getgenv().FastReloadEnabled then
                                    if name:find("reload") or name:find("reloadtime") then
                                        v.Value = 0.01
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

