-- Hitbox System
local originalSizes = {}

task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(function()
            for _, p in ipairs(game.Players:GetPlayers()) do
                if p ~= game.Players.LocalPlayer and p.Character then
                    local ally = isTeammate(p)
                    local char = p.Character
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and hum and hum.Health > 0 then
                        if not originalSizes[p] or originalSizes[p].Character ~= char then
                            originalSizes[p] = {
                                Character = char,
                                Size = hrp.Size,
                                Transparency = hrp.Transparency,
                                Material = hrp.Material,
                                Massless = hrp.Massless
                            }
                        end
                        
                        if getgenv().HitboxEnabled and not ally then
                            local sizeVal = getgenv().HitboxSize or 5
                            hrp.Size = Vector3.new(sizeVal, sizeVal, sizeVal)
                            hrp.Transparency = getgenv().HitboxTransparency or 0.5
                            hrp.Color = getgenv().HitboxColor or Color3.fromRGB(138, 43, 226)
                            hrp.Material = Enum.Material.Neon
                            hrp.CanCollide = false
                            hrp.Massless = true
                        else
                            if originalSizes[p] and originalSizes[p].Character == char then
                                hrp.Size = originalSizes[p].Size
                                hrp.Transparency = originalSizes[p].Transparency
                                hrp.Material = originalSizes[p].Material
                                hrp.Massless = originalSizes[p].Massless
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- Big Head Logic
local originalHeadSizes = {}

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character then
                local ally = isTeammate(p)
                local char = p.Character
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                if head and hum and hum.Health > 0 then
                    if not originalHeadSizes[head] then
                        originalHeadSizes[head] = {
                            Size = head.Size,
                            Massless = head.Massless
                        }
                    end
                    
                    if getgenv().BigHeadEnabled and not ally then
                        local targetSize = getgenv().BigHeadSize or 4
                        head.Size = Vector3.new(targetSize, targetSize, targetSize)
                        head.CanCollide = false
                        head.Massless = true
                    else
                        if originalHeadSizes[head] then
                            head.Size = originalHeadSizes[head].Size
                            head.Massless = originalHeadSizes[head].Massless
                        end
                    end
                end
            end
        end
    end)
end)

-- Tracers Logic
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        if not getgenv().TracersEnabled or not Camera then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then
                    local tracer = p.Character:FindFirstChild("1AN_TracerPart")
                    if tracer then tracer:Destroy() end
                end
            end
            return
        end

        local viewportSize = Camera.ViewportSize
        local topScreenRay = Camera:ViewportPointToRay(viewportSize.X / 2, 0)
        local originPos = topScreenRay.Origin

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local ally = isTeammate(p)
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local tracerPart = char:FindFirstChild("1AN_TracerPart")
                
                if hrp and hum and hum.Health > 0 and not ally then
                    if not tracerPart then
                        tracerPart = Instance.new("Part")
                        tracerPart.Name = "1AN_TracerPart"
                        tracerPart.Anchored = true
                        tracerPart.CanCollide = false
                        tracerPart.CastShadow = false
                        tracerPart.Material = Enum.Material.Neon
                        tracerPart.Color = Color3.fromRGB(138, 43, 226)
                        tracerPart.Transparency = 0.3
                        tracerPart.Parent = char
                    end
                    
                    local targetPos = hrp.Position
                    local distance = (originPos - targetPos).Magnitude
                    
                    tracerPart.Size = Vector3.new(0.05, 0.05, distance)
                    tracerPart.CFrame = CFrame.new(originPos, targetPos) * CFrame.new(0, 0, -distance / 2)
                else
                    if tracerPart then
                        tracerPart:Destroy()
                    end
                end
            end
        end
    end)
end)

