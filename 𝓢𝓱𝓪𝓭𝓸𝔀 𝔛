local function UpdateRainbowColor()
    if getgenv().RainbowHitbox then
        local hue = (time() * 0.15) % 1
        getgenv().HitboxColor = Color3.fromHSV(hue, 1, 1)
    end
end

local originalSizes = {}
local originalTransparencies = {}

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        UpdateRainbowColor()

        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= game.Players.LocalPlayer and player.Character then
                local character = player.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if humanoid and humanoid.Health > 0 then
                    local allParts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftLowerArm", "RightLowerArm", "LeftUpperArm", "RightUpperArm", "LeftLowerLeg", "RightLowerLeg", "LeftUpperLeg", "RightUpperLeg"}
                    
                    for _, partName in ipairs(allParts) do
                        local part = character:FindFirstChild(partName)
                        if part and part:IsA("BasePart") then
                            if not originalSizes[part] then
                                originalSizes[part] = part.Size
                                originalTransparencies[part] = part.Transparency
                            end

                            if getgenv().HitboxEnabled then
                                part.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                part.CanCollide = false
                                
                                if getgenv().HitboxInvisible then
                                    part.Transparency = 1
                                    part.Material = Enum.Material.Plastic
                                else
                                    part.Transparency = getgenv().HitboxTransparency
                                    part.Color = getgenv().HitboxColor
                                    part.Material = Enum.Material.Neon
                                end
                            else
                                part.Material = Enum.Material.Plastic
                                if originalSizes[part] then
                                    part.Size = originalSizes[part]
                                end
                                if originalTransparencies[part] then
                                    part.Transparency = originalTransparencies[part]
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

