-- Función de Team Check
local function isTeammate(player)
    if not getgenv().TeamCheckEnabled then return false end
    local localPlayer = game.Players.LocalPlayer
    if player == localPlayer then return true end
    if player.Team and localPlayer.Team and player.Team == localPlayer.Team then
        return true
    end
    local successTeam, result = pcall(function()
        return player.TeamColor and localPlayer.TeamColor and player.TeamColor == localPlayer.TeamColor
    end)
    if successTeam and result then
        return true
    end
    return false
end

