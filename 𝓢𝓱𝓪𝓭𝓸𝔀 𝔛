-- Bucle Principal en RenderStepped
RunService.RenderStepped:Connect(function()
    pcall(function()
        local Camera = workspace.CurrentCamera

        if getgenv().FovEnabled then
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            fovCircle.Radius = getgenv().FovRadius
            fovCircle.Color = getgenv().FovColor
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end

        if getgenv().AimbotEnabled then
            local target = getClosestTargetUniversal()
            if target then
                local targetCF = CFrame.new(Camera.CFrame.Position, target.Position)
                if getgenv().AimbotSmooth <= 1 then
                    Camera.CFrame = targetCF
                else
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / (getgenv().AimbotSmooth * 0.2))
                end
            end
        end

        if getgenv().SpinBotEnabled and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinSpeed), 0) end
        end

        if getgenv().NoclipEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        -- HITBOX PARA TODOS LOS JUGADORES (FIX)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 and hrp then
                    -- Aplicar hitbox a TODOS los jugadores (sin importar equipo)
                    if getgenv().HitboxEnabled then
                        if not originalHitboxStates[p] then
                            originalHitboxStates[p] = {}
                            for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                                local part = p.Character:FindFirstChild(name)
                                if part then
                                    table.insert(originalHitboxStates[p], { Part = part, Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide, Material = part.Material })
                                end
                            end
                        end
                        for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                            local part = p.Character:FindFirstChild(name)
                            if part then
                                part.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                part.Transparency = getgenv().HitboxTransparency
                                part.Color = getgenv().HitboxColor
                                part.Material = Enum.Material.Neon
                                part.CanCollide = false
                            end
                        end
                    end

                    -- Freeze solo para enemigos (si está activado)
                    if getgenv().FreezePlayersEnabled and not isTeammate(p) then
                        if not frozenPlayerPositions[p] then frozenPlayerPositions[p] = hrp.CFrame end
                        hrp.Anchored = true
                        hrp.CFrame = frozenPlayerPositions[p]
                        hum.WalkSpeed = 0
                    else
                        if frozenPlayerPositions[p] then
                            hrp.Anchored = false
                            hum.WalkSpeed = 16
                            frozenPlayerPositions[p] = nil
                        end
                    end
                end
            end
        end

        -- ESP Dibujos 2D Limpio (Solo caja y vida)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if not espDrawings[p] then
                    espDrawings[p] = {
                        BoxOutline = Drawing.new("Square"),
                        Box = Drawing.new("Square"),
                        HealthBarOutline = Drawing.new("Square"),
                        HealthBar = Drawing.new("Square")
                    }
                    espDrawings[p].BoxOutline.Filled = false
                    espDrawings[p].BoxOutline.Thickness = 3
                    espDrawings[p].BoxOutline.Color = Color3.new(0,0,0)
                    espDrawings[p].Box.Filled = false
                    espDrawings[p].Box.Thickness = 1
                    espDrawings[p].HealthBarOutline.Filled = true
                    espDrawings[p].HealthBarOutline.Color = Color3.new(0,0,0)
                    espDrawings[p].HealthBar.Filled = true
                end

                local d = espDrawings[p]
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if char and hrp and hum and hum.Health > 0 and not isTeammate(p) then
                    local cf, sz = char:GetBoundingBox()
                    local topPos = Camera:WorldToViewportPoint(cf.Position + Vector3.new(0, sz.Y / 2, 0))
                    local botPos = Camera:WorldToViewportPoint(cf.Position - Vector3.new(0, sz.Y / 2, 0))
                    local rootPos, vis = Camera:WorldToViewportPoint(hrp.Position)

                    if vis and getgenv().EspGlobalEnabled then
                        local h = math.abs(botPos.Y - topPos.Y)
                        local w = h / 2

                        d.BoxOutline.Size = Vector2.new(w, h)
                        d.BoxOutline.Position = Vector2.new(rootPos.X - w / 2, topPos.Y)
                        d.BoxOutline.Visible = true

                        d.Box.Size = Vector2.new(w, h)
                        d.Box.Position = Vector2.new(rootPos.X - w / 2, topPos.Y)
                        d.Box.Color = getTeamColor(p) -- Color según equipo
                        d.Box.Visible = true

                        local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local bH = h * hpPct
                        d.HealthBarOutline.Size = Vector2.new(4, h + 2)
                        d.HealthBarOutline.Position = Vector2.new(rootPos.X - w / 2 - 6, topPos.Y - 1)
                        d.HealthBarOutline.Visible = true

                        d.HealthBar.Size = Vector2.new(2, bH)
                        d.HealthBar.Position = Vector2.new(rootPos.X - w / 2 - 5, topPos.Y + (h - bH))
                        d.HealthBar.Color = Color3.fromRGB(255 - (hpPct * 255), hpPct * 255, 0)
                        d.HealthBar.Visible = true
                    else
                        d.BoxOutline.Visible = false
                        d.Box.Visible = false
                        d.HealthBarOutline.Visible = false
                        d.HealthBar.Visible = false
                    end
                else
                    d.BoxOutline.Visible = false
                    d.Box.Visible = false
                    d.HealthBarOutline.Visible = false
                    d.HealthBar.Visible = false
                end
            end
        end
    end)
end)

