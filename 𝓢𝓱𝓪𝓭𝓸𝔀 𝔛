Tabs.Visual:Section({ Title = "X-Ray (Ver a través de paredes)" })
Tabs.Visual:Toggle({ Title = "Activar X-Ray", Value = false, Callback = function(v)
    getgenv().XRayEnabled = v
    if v then
        -- Activar X-Ray: Guardar transparencias originales y hacer transparentes
        if not xrayApplied then
            originalTransparencies = {}  -- Limpiar el diccionario
            for _, part in ipairs(workspace:GetDescendants()) do
                if part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character) then
                    -- Guardar la transparencia original
                    originalTransparencies[part] = part.Transparency
                    -- Hacer transparente si no lo está ya
                    if part.Transparency < 0.5 then
                        part.Transparency = 0.7
                    end
                end
            end
            xrayApplied = true
        end
    else
        -- Desactivar X-Ray: Restaurar transparencias originales
        if xrayApplied then
            for part, originalTransparency in pairs(originalTransparencies) do
                if part and part.Parent then  -- Verificar que la parte aún existe
                    part.Transparency = originalTransparency
                end
            end
            originalTransparencies = {}  -- Limpiar el diccionario
            xrayApplied = false
        end
    end
end })

