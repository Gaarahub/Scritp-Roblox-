-- Bucle Principal en RenderStepped optimizado (Incluyendo renderizado de FOV en pantalla)
RunService.RenderStepped:Connect(function()
    pcall(function()
        local Camera = workspace.CurrentCamera

        -- Actualización del FOV visual en pantalla
        if getgenv().FovEnabled then
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            fovCircle.Radius = getgenv().FovRadius
            fovCircle.Color = getgenv().FovColor
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end

        if getgenv().AimbotEnabled then
            local target = getClosestTargetUniversal()
            if target then
                local targetCF = CFrame.new(Camera.CFrame.Position, target.Position)
                if getgenv().AimbotSmooth <= 1 then
                    Camera.CFrame = targetCF
                else
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / (getgenv().AimbotSmooth * 0.2))
                end
            end
        end

        if getgenv().SpinBotEnabled and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinSpeed), 0) end
        end

        if getgenv().NoclipEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        -- Proxy Hitbox update
        for p, proxy in pairs(proxyHitboxes) do
            if proxy and proxy.Parent then
                if getgenv().HoodHitboxEnabled and p.Character and p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 and not isTeammate(p) then
                    proxy.Size = Vector3.new(getgenv().HoodHitboxSize, getgenv().HoodHitboxSize, getgenv().HoodHitboxSize)
                    proxy.Transparency = 0.85
                    proxy.CanCollide = true
                else
                    proxy.Transparency = 1
                    proxy.CanCollide = false
                end
            end
        end

        -- Hitbox estándar y Freeze
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not isTeammate(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp then
                    if getgenv().FreezePlayersEnabled then
                        if not frozenPlayerPositions[p] then frozenPlayerPositions[p] = hrp.CFrame end
                        hrp.Anchored = true
                        hrp.CFrame = frozenPlayerPositions[p]
                        hum.WalkSpeed = 0
                    else
                        if frozenPlayerPositions[p] then
                            hrp.Anchored = false
                            hum.WalkSpeed = 16
                            frozenPlayerPositions[p] = nil
                        end
                    end

                    if getgenv().HitboxEnabled then
                        if not originalHitboxStates[p] then
                            originalHitboxStates[p] = {}
                            for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                                local part = p.Character:FindFirstChild(name)
                                if part then
                                    table.insert(originalHitboxStates[p], { Part = part, Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide, Material = part.Material })
                                end
                            end
                        end
                        for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                            local part = p.Character:FindFirstChild(name)
                            if part then
                                part.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                part.Transparency = getgenv().HitboxTransparency
                                part.Color = getgenv().HitboxColor
                                part.Material = Enum.Material.Neon
                                part.CanCollide = false
                            end
                        end
                    end
                end
            end
        end

        -- Chams ESP
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not isTeammate(p) then
                local hl = p.Character:FindFirstChild("AlexX_ESP")
                if getgenv().EspEnemyEnabled then
                    if not hl then
                        hl = Instance.new("Highlight", p.Character)
                        hl.Name = "AlexX_ESP"
                        hl.FillColor = Color3.fromRGB(255, 30, 30)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.35
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                else
                    if hl then hl:Destroy() end
                end
            end
        end

        -- ESP Dibujos 2D
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if not espDrawings[p] then
                    espDrawings[p] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line"),
                        Name = Drawing.new("Text"),
                        HealthBarOutline = Drawing.new("Square"),
                        HealthBar = Drawing.new("Square"),
                        Skeleton = { Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line") }
                    }
                    espDrawings[p].Box.Filled = false
                    espDrawings[p].Name.Size = 14
                    espDrawings[p].Name.Center = true
                    espDrawings[p].Name.Outline = true
                    espDrawings[p].HealthBarOutline.Filled = true
                    espDrawings[p].HealthBarOutline.Color = Color3.new(0,0,0)
                    espDrawings[p].HealthBar.Filled = true
                end

                local d = espDrawings[p]
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local head = char and char:FindFirstChild("Head")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if char and hrp and head and hum and hum.Health > 0 and not isTeammate(p) then
                    local cf, sz = char:GetBoundingBox()
                    local topPos = Camera:WorldToViewportPoint(cf.Position + Vector3.new(0, sz.Y / 2, 0))
                    local botPos = Camera:WorldToViewportPoint(cf.Position - Vector3.new(0, sz.Y / 2, 0))
                    local rootPos, vis = Camera:WorldToViewportPoint(hrp.Position)

                    if vis then
                        local h = math.abs(botPos.Y - topPos.Y)
                        local w = h / 2

                        d.Box.Visible = getgenv().EspBoxesEnabled
                        if d.Box.Visible then
                            d.Box.Size = Vector2.new(w, h)
                            d.Box.Position = Vector2.new(rootPos.X - w / 2, topPos.Y)
                            d.Box.Color = getgenv().EspEnemyColor
                        end

                        d.Tracer.Visible = getgenv().EspTracersEnabled
                        if d.Tracer.Visible then
                            d.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            d.Tracer.To = Vector2.new(rootPos.X, botPos.Y)
                            d.Tracer.Color = getgenv().EspEnemyColor
                        end

                        d.Name.Visible = getgenv().EspNamesEnabled
                        if d.Name.Visible then
                            local distStr = getgenv().EspDistanceEnabled and (" [" .. math.floor((hrp.Position - Camera.CFrame.Position).Magnitude) .. "m]") or ""
                            d.Name.Text = p.Name .. " [" .. math.floor(hum.Health) .. "HP]" .. distStr
                            d.Name.Position = Vector2.new(rootPos.X, topPos.Y - 18)
                        end

                        d.HealthBar.Visible = getgenv().EspHealthBarEnabled
                        d.HealthBarOutline.Visible = getgenv().EspHealthBarEnabled
                        if getgenv().EspHealthBarEnabled then
                            local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            local bH = h * hpPct
                            d.HealthBarOutline.Size = Vector2.new(3, h + 2)
                            d.HealthBarOutline.Position = Vector2.new(rootPos.X - w / 2 - 6, topPos.Y - 1)
                            d.HealthBar.Size = Vector2.new(1, bH)
                            d.HealthBar.Position = Vector2.new(rootPos.X - w / 2 - 5, topPos.Y + (h - bH))
                            d.HealthBar.Color = Color3.fromRGB(255 - (hpPct * 255), hpPct * 255, 0)
                        end

                        if getgenv().EspSkeletonEnabled then
                            local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                            if head and upperTorso then
                                local hP = Camera:WorldToViewportPoint(head.Position)
                                local tP = Camera:WorldToViewportPoint(upperTorso.Position)
                                d.Skeleton[1].From = Vector2.new(hP.X, hP.Y)
                                d.Skeleton[1].To = Vector2.new(tP.X, tP.Y)
                                d.Skeleton[1].Visible = true
                            else
                                for _, l in pairs(d.Skeleton) do l.Visible = false end
                            end
                        else
                            for _, l in pairs(d.Skeleton) do l.Visible = false end
                        end
                    else
                        d.Box.Visible, d.Tracer.Visible, d.Name.Visible, d.HealthBar.Visible, d.HealthBarOutline.Visible = false, false, false, false, false
                        for _, l in pairs(d.Skeleton) do l.Visible = false end
                    end
                else
                    d.Box.Visible, d.Tracer.Visible, d.Name.Visible, d.HealthBar.Visible, d.HealthBarOutline.Visible = false, false, false, false, false
                    if d.Skeleton then for _, l in pairs(d.Skeleton) do l.Visible = false end end
                end
            end
        end
    end)
end)

