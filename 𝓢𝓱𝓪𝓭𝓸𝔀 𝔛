-- Función SIMPLE y EFECTIVA para detectar aliados
function isTeammate(player)
    if player == LocalPlayer then return true end
    if not getgenv().TeamCheckEnabled then return false end
    
    -- SOLO usar el método más confiable: comparar Teams directamente
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team == player.Team then
            return true
        end
    end
    
    -- Si no hay Teams, verificar TeamColor
    if LocalPlayer.TeamColor and player.TeamColor then
        if LocalPlayer.TeamColor == player.TeamColor then
            return true
        end
    end
    
    -- Si no se detecta ningún equipo, NO son aliados
    return false
end

-- Función para obtener el color del equipo (para ESP)
function getTeamColor(player)
    if isTeammate(player) then
        return Color3.fromRGB(0, 255, 0) -- Verde para aliados
    else
        return Color3.fromRGB(255, 0, 0) -- Rojo para enemigos
    end
end

