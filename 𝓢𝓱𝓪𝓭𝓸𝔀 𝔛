local function playKillSound()
    if getgenv().KillSoundEnabled and soundInstance and getgenv().SelectedKillSound then
        soundInstance.SoundId = "rbxassetid://" .. tostring(getgenv().SelectedKillSound)
        soundInstance:Play()
        pcall(function()
            if UserInputService.TouchEnabled then
                UserInputService:SetVibration(Enum.VibrationMotor.Medium, 0.5)
            end
        end)
    end
end

local function didLocalPlayerKill(victim)
    if not victim or not victim.Character then return false end
    local hum = victim.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local creatorTag = hum:FindFirstChild("creator")
    if creatorTag and creatorTag:IsA("ObjectValue") and creatorTag.Value == LocalPlayer then return true end
    local lastHit = myLastHitTime[victim]
    if lastHit and (tick() - lastHit) <= 1.5 then return true end
    local damage = myDamageDealt[victim] or 0
    if damage > (hum.MaxHealth * 0.5) then return true end
    return false
end

local function setupDamageTracker(player)
    if player == LocalPlayer then return end
    myKillTracker[player] = false
    myLastHitTime[player] = 0
    myDamageDealt[player] = 0
    
    local function onCharacterAdded(char)
        myKillTracker[player] = false
        myLastHitTime[player] = 0
        myDamageDealt[player] = 0
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        local lastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth < lastHealth then
                local damage = lastHealth - newHealth
                if damage > 0 then
                    local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    if isShooting then
                        myDamageDealt[player] = myDamageDealt[player] + damage
                        myLastHitTime[player] = tick()
                    end
                end
            end
            lastHealth = newHealth
            if newHealth <= 0 and lastHealth > 0 and not myKillTracker[player] then
                myKillTracker[player] = true
                if didLocalPlayerKill(player) then playKillSound() end
            end
        end)
        hum.Died:Connect(function()
            if not myKillTracker[player] then
                myKillTracker[player] = true
                if didLocalPlayerKill(player) then playKillSound() end
            end
        end)
    end
    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then setupDamageTracker(p) end end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then setupDamageTracker(p) end end)
Players.PlayerRemoving:Connect(function(p) myKillTracker[p] = nil myLastHitTime[p] = nil myDamageDealt[p] = nil end)

-- =====================================================
--  TEAM CHECK & UTILIDADES
-- =====================================================
function isTeammate(player)
    if player == LocalPlayer then return true end
    if not getgenv().TeamCheckEnabled then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return true end
    if LocalPlayer.TeamColor and player.TeamColor and LocalPlayer.TeamColor == player.TeamColor then return true end
    if LocalPlayer:IsInGroup(player.UserId) then return true end
    return false
end

function getTeamColor(player)
    if isTeammate(player) then return Color3.fromRGB(0, 255, 0) else return Color3.fromRGB(255, 0, 0) end
end

function isEnemyVisible(player)
    if not player or not player.Character then return false end
    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    local camPos = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector
    local targetPart = head or hrp
    if getgenv().TriggerbotHeadshot and head then targetPart = head end
    local targetPos = targetPart.Position
    local distance = (targetPos - camPos).Magnitude
    if distance > getgenv().TriggerbotRange then return false end
    local toTarget = (targetPos - camPos).Unit
    local angle = math.acos(math.clamp(camLook:Dot(toTarget), -1, 1))
    if math.deg(angle) > getgenv().TriggerbotFOV / 2 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    params.IgnoreWater = true
    local raycastResult = workspace:Raycast(camPos, (targetPos - camPos).Unit * distance, params)
    if not raycastResult then return true end
    local hitPart = raycastResult.Instance
    if hitPart and hitPart:IsDescendantOf(char) then return true end
    return false
end

function findBestTarget()
    local bestTarget = nil
    local bestDistance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isTeammate(player) and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and isEnemyVisible(player) then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local distance = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if distance < bestDistance then
                        bestDistance = distance
                        bestTarget = player
                    end
                end
            end
        end
    end
    return bestTarget
end

function shoot()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    local remoteEvent = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("Fire") or tool:FindFirstChild("Shoot")
    if remoteEvent then pcall(function() remoteEvent:FireServer() end) end
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
end

task.spawn(function()
    while task.wait(0.01) do
