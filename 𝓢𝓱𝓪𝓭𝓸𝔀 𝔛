local function isTeammate(player)
    if not getgenv().TeamCheckEnabled then return false end
    if player == LocalPlayer then return true end
    if not LocalPlayer.Team or not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function getClosestTargetUniversal()
    local Camera = workspace.CurrentCamera
    local closestPart = nil
    local shortestDist = getgenv().FovRadius
    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = p.Character:FindFirstChild(getgenv().AimbotPart)
            if hum and hum.Health > 0 and targetPart then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local predictedPosition = targetPart.Position + (hrp and (hrp.Velocity * 0.08) or Vector3.zero)
                local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPosition)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = targetPart
                    end
                end
            end
        end
    end
    return closestPart
end

local function setupProxyHitbox(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char)
        task.wait(1)
        if proxyHitboxes[player] then pcall(function() proxyHitboxes[player]:Destroy() end) end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end
        
        local proxy = Instance.new("Part")
        proxy.Size = Vector3.new(getgenv().HoodHitboxSize, getgenv().HoodHitboxSize, getgenv().HoodHitboxSize)
        proxy.Transparency = 0.85
        proxy.CanCollide = true
        proxy.Massless = true
        proxy.Color = Color3.fromRGB(255, 0, 0)
        proxy.Material = Enum.Material.Neon
        proxy.Parent = workspace
        
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local noCol = Instance.new("NoCollisionConstraint")
                noCol.Part0 = proxy
                noCol.Part1 = part
                noCol.Parent = proxy
            end
        end
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = hrp
        weld.Part1 = proxy
        weld.Parent = hrp
        proxy.CFrame = hrp.CFrame
        proxyHitboxes[player] = proxy
    end)
end

for _, p in ipairs(Players:GetPlayers()) do setupProxyHitbox(p) end
Players.PlayerAdded:Connect(setupProxyHitbox)

Players.PlayerRemoving:Connect(function(p)
    if proxyHitboxes[p] then pcall(function() proxyHitboxes[p]:Destroy() end); proxyHitboxes[p] = nil end
    if espDrawings[p] then
        pcall(function()
            for _, d in pairs(espDrawings[p]) do
                if type(d) == "table" then for _, sub in pairs(d) do sub:Remove() end
                else d:Remove() end
            end
        end)
        espDrawings[p] = nil
    end
    originalHitboxStates[p] = nil
    frozenPlayerPositions[p] = nil
end)

