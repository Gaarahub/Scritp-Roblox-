local LocalPlayer = game.Players.LocalPlayer

local function CreateHighlight(model, color)
    if not model:FindFirstChild("1AN_ESP") then
        local hl = Instance.new("Highlight")
        hl.Name = "1AN_ESP"
        hl.Adornee = model
        hl.FillColor = color
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Parent = model
    end
end

local function RemoveHighlight(model)
    local hl = model:FindFirstChild("1AN_ESP")
    if hl then hl:Destroy() end
end

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local isEnemy = true
                if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                    isEnemy = false
                end
                
                if getgenv().EspEnemyEnabled and isEnemy then
                    CreateHighlight(player.Character, Color3.fromRGB(255, 0, 0))
                else
                    local hl = player.Character:FindFirstChild("1AN_ESP")
                    if hl and not getgenv().EspEnemyEnabled then hl:Destroy() end
                end
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                local isPlayer = game.Players:GetPlayerFromCharacter(obj)
                if not isPlayer then
                    if getgenv().EspNpcEnabled then
                        CreateHighlight(obj, Color3.fromRGB(0, 255, 255))
                    else
                        RemoveHighlight(obj)
                    end
                end
            end
        end
    end)
end)

