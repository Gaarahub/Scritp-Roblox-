task.spawn(function()
    while true do
        task.wait(0.2)
        pcall(function()
            if getgenv().RapidFireEnabled then
                local player = game.Players.LocalPlayer
                if player.Character then
                    for _, tool in ipairs(player.Character:GetChildren()) do
                        if tool:IsA("Tool") then
