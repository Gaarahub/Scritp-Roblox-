--  ESP SIMPLIFICADO (Solo Line, Health y Distance)
-- =====================================================

-- Función para crear los elementos de dibujo para cada jugador
local function createEspDrawings(player)
    local drawings = {}
    
    -- Línea (Line)
    drawings.Line = Drawing.new("Line")
    drawings.Line.Thickness = 1.5
    drawings.Line.Visible = false
    
    -- Barra de vida (Health)
    drawings.HealthBarOutline = Drawing.new("Square")
    drawings.HealthBarOutline.Filled = true
    drawings.HealthBarOutline.Color = Color3.new(0, 0, 0)
    drawings.HealthBarOutline.Visible = false
    
    drawings.HealthBar = Drawing.new("Square")
    drawings.HealthBar.Filled = true
    drawings.HealthBar.Visible = false
    
    -- Distancia (Distance)
    drawings.Distance = Drawing.new("Text")
    drawings.Distance.Size = 12
    drawings.Distance.Center = true
    drawings.Distance.Outline = true
    drawings.Distance.OutlineColor = Color3.new(0, 0, 0)
    drawings.Distance.Visible = false
    
    espDrawings[player] = drawings
end

-- Función para actualizar el ESP de un jugador
local function updateEsp(player)
    local drawings = espDrawings[player]
    if not drawings then return end
    
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    -- Ocultar todo si no hay personaje o está muerto o es aliado
    if not char or not hrp or not hum or hum.Health <= 0 or isTeammate(player) or not getgenv().EspGlobalEnabled then
        drawings.Line.Visible = false
        drawings.HealthBarOutline.Visible = false
        drawings.HealthBar.Visible = false
        drawings.Distance.Visible = false
        return
    end
    
    -- Obtener la posición en pantalla
    local cf, sz = char:GetBoundingBox()
    local topPos = Camera:WorldToViewportPoint(cf.Position + Vector3.new(0, sz.Y / 2, 0))
    local botPos = Camera:WorldToViewportPoint(cf.Position - Vector3.new(0, sz.Y / 2, 0))
    local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    
    -- Si no está en pantalla, ocultar
    if not onScreen then
        drawings.Line.Visible = false
        drawings.HealthBarOutline.Visible = false
        drawings.HealthBar.Visible = false
        drawings.Distance.Visible = false
        return
    end
    
    -- Calcular dimensiones
    local h = math.abs(botPos.Y - topPos.Y)
    local w = h / 2
    local centerX = rootPos.X
    local topY = topPos.Y
    
    -- Color del ESP (rojo para enemigos)
    local espColor = getTeamColor(player)
    if getgenv().EspMainColor ~= Color3.fromRGB(255, 0, 0) then
        espColor = getgenv().EspMainColor
    end
    
    -- 1. LÍNEA (LINE)
    if getgenv().EspLineEnabled then
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        drawings.Line.From = screenCenter
        drawings.Line.To = Vector2.new(centerX, topY + h / 2)
        drawings.Line.Color = espColor
        drawings.Line.Visible = true
    else
        drawings.Line.Visible = false
    end
    
    -- 2. BARRA DE VIDA (HEALTH)
    if getgenv().EspHealthEnabled then
        local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local bH = h * hpPct
        
        drawings.HealthBarOutline.Size = Vector2.new(4, h + 2)
        drawings.HealthBarOutline.Position = Vector2.new(centerX - w / 2 - 6, topY - 1)
        drawings.HealthBarOutline.Visible = true
        
        drawings.HealthBar.Size = Vector2.new(2, bH)
        drawings.HealthBar.Position = Vector2.new(centerX - w / 2 - 5, topY + (h - bH))
        drawings.HealthBar.Color = Color3.fromRGB(255 - (hpPct * 255), hpPct * 255, 0)
        drawings.HealthBar.Visible = true
    else
        drawings.HealthBarOutline.Visible = false
        drawings.HealthBar.Visible = false
    end
    
    -- 3. DISTANCIA (DISTANCE)
    if getgenv().EspDistanceEnabled then
        local distance = math.floor((hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
        drawings.Distance.Text = tostring(distance) .. "m"
        drawings.Distance.Position = Vector2.new(centerX, botPos.Y + 5)
        drawings.Distance.Color = Color3.fromRGB(255, 255, 255)
        drawings.Distance.Visible = true
    else
        drawings.Distance.Visible = false
    end
end

-- Crear ESP para todos los jugadores existentes
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        createEspDrawings(p)
    end
end

-- Crear ESP para nuevos jugadores
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then
        createEspDrawings(p)
    end
end)

-- Limpiar ESP cuando un jugador sale
Players.PlayerRemoving:Connect(function(p)
    if espDrawings[p] then
        for _, drawing in pairs(espDrawings[p]) do
            drawing:Remove()
        end
        espDrawings[p] = nil
    end
end)

-- Bucle Principal en RenderStepped
RunService.RenderStepped:Connect(function()
    pcall(function()
        local Camera = workspace.CurrentCamera

        if getgenv().FovEnabled then
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            fovCircle.Radius = getgenv().FovRadius
            fovCircle.Color = getgenv().FovColor
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end

        if getgenv().AimbotEnabled then
            local target = getClosestTargetUniversal()
            if target then
                local targetCF = CFrame.new(Camera.CFrame.Position, target.Position)
                if getgenv().AimbotSmooth <= 1 then
                    Camera.CFrame = targetCF
                else
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / (getgenv().AimbotSmooth * 0.2))
                end
            end
        end

        if getgenv().SpinBotEnabled and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinSpeed), 0) end
        end

        if getgenv().NoclipEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        -- HITBOX PARA TODOS LOS JUGADORES (FIX) - AHORA RESPETA TEAM CHECK
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not isTeammate(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 and hrp then
                    if getgenv().HitboxEnabled then
                        if not originalHitboxStates[p] then
                            originalHitboxStates[p] = {}
                            for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                                local part = p.Character:FindFirstChild(name)
                                if part then
                                    table.insert(originalHitboxStates[p], { Part = part, Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide, Material = part.Material })
                                end
                            end
                        end
                        for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                            local part = p.Character:FindFirstChild(name)
                            if part then
                                part.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                part.Transparency = getgenv().HitboxTransparency
                                part.Color = getgenv().HitboxColor
                                part.Material = Enum.Material.Neon
                                part.CanCollide = false
                            end
                        end
                    end

                    if getgenv().FreezePlayersEnabled and not isTeammate(p) then
                        if not frozenPlayerPositions[p] then frozenPlayerPositions[p] = hrp.CFrame end
                        hrp.Anchored = true
                        hrp.CFrame = frozenPlayerPositions[p]
                        hum.WalkSpeed = 0
                    else
                        if frozenPlayerPositions[p] then
                            hrp.Anchored = false
                            hum.WalkSpeed = 16
                            frozenPlayerPositions[p] = nil
                        end
                    end
                end
            end
        end

        -- ACTUALIZAR ESP PARA TODOS LOS JUGADORES
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                updateEsp(p)
            end
        end
    end)
end)

