local function isTeammate(player)
    if not getgenv().TeamCheckEnabled then return false end
    if player == LocalPlayer then return true end
    if not LocalPlayer.Team or not player.Team then return false end
    if player.Team == LocalPlayer.Team then return true end
    local successTeam, result = pcall(function()
        return player.TeamColor and LocalPlayer.TeamColor and player.TeamColor == LocalPlayer.TeamColor
    end)
    return successTeam and result or false
end

-- SELECCIÓN ESTRICTA DENTRO DEL FOV PARA SILENT AIM
local function getClosestTarget()
    local cam = workspace.CurrentCamera
    local viewportSize = cam.ViewportSize
    local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local closestPart = nil
    local shortestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ally = isTeammate(p)
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 and not ally then
                local targetPartName = getgenv().SilentAimMode
                local targetPart = char:FindFirstChild(targetPartName) or char:FindFirstChild("Head")
                
                if targetPart then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (screenPos2D - centerScreen).Magnitude
                        
                        if dist <= getgenv().FovRadius and dist < shortestDist then
                            shortestDist = dist
                            closestPart = targetPart
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

-- SELECCIÓN FLUIDA Y ESTRICTA DENTRO DEL FOV PARA AIMBOT DE CÁMARA
local function getClosestTargetForAimbot()
    local closestPart = nil
    local shortestDist = math.huge
    local cam = workspace.CurrentCamera
    local viewportSize = cam.ViewportSize
    local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ally = isTeammate(p)
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")

            if hum and hum.Health > 0 and not ally then
                local targetPartName = getgenv().AimbotPart or "Head"
                local targetPart = char:FindFirstChild(targetPartName) or char:FindFirstChild("Head")

                if targetPart then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (screenPos2D - centerScreen).Magnitude
                        
                        -- Validar estrictamente que esté dentro del FOV en pantalla
                        if dist <= getgenv().FovRadius and dist < shortestDist then
                            shortestDist = dist
                            closestPart = targetPart
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

