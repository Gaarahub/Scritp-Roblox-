local headPart = char and char:FindFirstChild("Head")
local hum = char and char:FindFirstChildOfClass("Humanoid")

if char and rootPart and headPart and hum and hum.Health > 0 and not isTeammate(p) then
-- Usamos CFrame para proyectar esquinas reales 3D del personaje a 2D de forma robusta
local cframe, size = char:GetBoundingBox()
local topCenter = cframe.Position + Vector3.new(0, size.Y / 2 + 0.5, 0)
local bottomCenter = cframe.Position - Vector3.new(0, size.Y / 2, 0)

local topPos, topVisible = Camera:WorldToViewportPoint(topCenter)
local bottomPos, bottomVisible = Camera:WorldToViewportPoint(bottomCenter)
local rootPos, rootVisible = Camera:WorldToViewportPoint(rootPart.Position)

if rootVisible then
local height = math.abs(bottomPos.Y - topPos.Y)
local width = height / 2

-- Cajas (Boxes)
if getgenv().EspBoxesEnabled then
drawings.Box.Size = Vector2.new(width, height)
drawings.Box.Position = Vector2.new(rootPos.X - width / 2, topPos.Y)
drawings.Box.Color = getgenv().EspEnemyColor
drawings.Box.Visible = true
else
drawings.Box.Visible = false
end

-- Tracers (Líneas)
