-- SILENT AIM BLINDADO CONTRA CRASHES (Validación estricta de argumentos)
pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().SilentAimMode and getgenv().SilentAimMode ~= "None" then
            local targetPart = getClosestTarget()
            if targetPart and targetPart.Parent then
                if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                    if typeof(args[1]) == "Ray" then
                        local ray = args[1]
                        local newDir = (targetPart.Position - ray.Origin).Unit * ray.Direction.Magnitude
                        args[1] = Ray.new(ray.Origin, newDir)
                        return oldNamecall(self, unpack(args))
                    end
                elseif method == "Raycast" then
                    if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                        local origin = args[1]
                        local direction = args[2]
                        args[2] = (targetPart.Position - origin).Unit * direction.Magnitude
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

