local function getClosestTargetUniversal()
    local closestPart = nil
    local shortestDist = getgenv().FovRadius
    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = p.Character:FindFirstChild(getgenv().AimbotPart)
            if hum and hum.Health > 0 and targetPart then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local predictedPosition = targetPart.Position + (hrp and (hrp.Velocity * 0.08) or Vector3.zero)
                local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPosition)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = targetPart
                    end
                end
            end
        end
    end
    return closestPart
end

local function createESPDrawings(player)
    if espObjects[player] then return end
    local drawings = {}
    local box = Drawing.new("Square") box.Thickness = getgenv().ESPThickness box.Transparency = 1 box.Visible = false drawings.Box = box
    local line = Drawing.new("Line") line.Thickness = getgenv().ESPThickness line.Transparency = 1 line.Visible = false drawings.Line = line
    local name = Drawing.new("Text") name.Size = 14 name.Center = true name.Outline = true name.Visible = false drawings.Name = name
    local health = Drawing.new("Text") health.Size = 12 health.Center = true health.Outline = true health.Visible = false drawings.Health = health
    local distance = Drawing.new("Text") distance.Size = 12 distance.Center = true distance.Outline = true distance.Visible = false drawings.Distance = distance
    espObjects[player] = drawings
end

local function updateESP()
    if not getgenv().ESPEnabled then return end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            if hum and hum.Health > 0 and hrp and head then
                createESPDrawings(player)
                local drawings = espObjects[player]
                local color = getTeamColor(player)
                local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                local rootPos, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position)
                if headOnScreen and rootOnScreen then
                    local height = math.abs(headPos.Y - rootPos.Y) * 2
                    local width = height * 0.6
                    if getgenv().ESPBoxEnabled then
                        drawings.Box.Visible = true drawings.Box.Color = color drawings.Box.Thickness = getgenv().ESPThickness
                        drawings.Box.Position = Vector2.new(rootPos.X - width/2, rootPos.Y - height/2) drawings.Box.Size = Vector2.new(width, height)
                    else drawings.Box.Visible = false end
                    if getgenv().ESPLineEnabled then
                        drawings.Line.Visible = true drawings.Line.Color = color drawings.Line.Thickness = getgenv().ESPThickness
                        drawings.Line.From = screenCenter drawings.Line.To = Vector2.new(rootPos.X, rootPos.Y)
                    else drawings.Line.Visible = false end
                    if getgenv().ESPNameEnabled then
                        drawings.Name.Visible = true drawings.Name.Text = player.Name drawings.Name.Color = color
                        drawings.Name.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 20)
                    else drawings.Name.Visible = false end
                    if getgenv().ESPHealthEnabled then
                        drawings.Health.Visible = true drawings.Health.Text = math.floor((hum.Health / hum.MaxHealth) * 100) .. "%"
                        drawings.Health.Color = Color3.fromRGB(0, 255, 0) drawings.Health.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 5)
                    else drawings.Health.Visible = false end
                    if getgenv().ESPDistanceEnabled then
                        drawings.Distance.Visible = true drawings.Distance.Text = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude) .. "m"
                        drawings.Distance.Color = color drawings.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + height/2 + 5)
                    else drawings.Distance.Visible = false end
                else
                    for _, drawing in pairs(drawings) do drawing.Visible = false end
                end
            else
                if espObjects[player] then for _, drawing in pairs(espObjects[player]) do drawing.Visible = false end end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if getgenv().FovEnabled then
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            fovCircle.Radius = getgenv().FovRadius fovCircle.Color = getgenv().FovColor fovCircle.Visible = true
        else fovCircle.Visible = false end

        if getgenv().AimbotEnabled then
            local target = getClosestTargetUniversal()
            if target then
                local targetCF = CFrame.new(Camera.CFrame.Position, target.Position)
                if getgenv().AimbotSmooth <= 1 then Camera.CFrame = targetCF
                else Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / (getgenv().AimbotSmooth * 0.2)) end
            end
        end

        if getgenv().SpinBotEnabled and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinSpeed), 0) end
        end

        if getgenv().NoclipEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
        end

        updateESP()

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not isTeammate(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp then
                    if getgenv().HitboxEnabled then
                        if not originalHitboxStates[p] then
                            originalHitboxStates[p] = {}
                            for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                                local part = p.Character:FindFirstChild(name)
                                if part then table.insert(originalHitboxStates[p], { Part = part, Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide, Material = part.Material }) end
                            end
                        end
                        for _, name in ipairs({"Head", "HumanoidRootPart", "UpperTorso"}) do
                            local part = p.Character:FindFirstChild(name)
                            if part then
                                part.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                                part.Transparency = getgenv().HitboxTransparency part.Color = getgenv().HitboxColor
                                part.Material = Enum.Material.Neon part.CanCollide = false
                            end
                        end
                    end

                    if getgenv().FreezePlayersEnabled and not isTeammate(p) then
                        if not frozenPlayerPositions[p] then frozenPlayerPositions[p] = hrp.CFrame end
                        hrp.Anchored = true hrp.CFrame = frozenPlayerPositions[p] hum.WalkSpeed = 0
                    else
                        if frozenPlayerPositions[p] then hrp.Anchored = false hum.WalkSpeed = 16 frozenPlayerPositions[p] = nil end
                    end
                end
            end
        end
    end)
end)

