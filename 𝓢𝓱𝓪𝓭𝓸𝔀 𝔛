local originalSizes = {}
local originalTransparencies = {}
local originalHeadSizes = {}

-- Hispos (Hitbox del Pecho / HumanoidRootPart)
game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character then
                local ally = isTeammate(p)
                local char = p.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                if hum and hrp and hum.Health > 0 then
                    local part = hrp
                    if not originalSizes[part] then
                        originalSizes[part] = part.Size
                        originalTransparencies[part] = part.Transparency
                    end
                    
                    if getgenv().HitboxEnabled and not ally then
                        local sizeVal = getgenv().HitboxSize or 5
                        part.Size = Vector3.new(sizeVal, sizeVal, sizeVal)
                        part.Transparency = getgenv().HitboxTransparency
                        part.Color = getgenv().HitboxColor
                        part.Material = Enum.Material.Neon
                        part.CanCollide = false
                    else
                        part.Material = Enum.Material.Plastic
                        if originalSizes[part] then part.Size = originalSizes[part] end
                        if originalTransparencies[part] then part.Transparency = originalTransparencies[part] end
                    end
                end
            end
        end
    end)
end)

-- Big Head Logic (Soporta hasta 10 seguro)
game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character then
                local ally = isTeammate(p)
                local char = p.Character
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                if head and hum and hum.Health > 0 then
                    if not originalHeadSizes[head] then
                        originalHeadSizes[head] = head.Size
                    end
                    
                    if getgenv().BigHeadEnabled and not ally then
                        local targetSize = getgenv().BigHeadSize or 4
                        head.Size = Vector3.new(targetSize, targetSize, targetSize)
                        head.CanCollide = false
                        head.Massless = true
                        
                        local neck = char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck") or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck"))
                        if neck then
                            neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, 0)
                        end
                    else
                        head.Massless = false
                        if originalHeadSizes[head] then
                            head.Size = originalHeadSizes[head]
                        end
                    end
                end
            end
        end
    end)
end)

-- Tracers Logic
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        if not getgenv().TracersEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("1AN_TracerPart") then
                    p.Character["1AN_TracerPart"]:Destroy()
                end
            end
            return
        end

        local viewport = Camera.ViewportSize
        local ray = Camera:ScreenPointToRay(viewport.X / 2, 0)
        local p1 = ray.Origin + (ray.Direction * 0.2)

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local ally = isTeammate(p)
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local tracerPart = char:FindFirstChild("1AN_TracerPart")
                
                if hrp and hum and hum.Health > 0 and not ally then
                    if not tracerPart then
                        tracerPart = Instance.new("Part")
                        tracerPart.Name = "1AN_TracerPart"
                        tracerPart.Anchored = true
                        tracerPart.CanCollide = false
                        tracerPart.CastShadow = false
                        tracerPart.Material = Enum.Material.Neon
                        tracerPart.Color = Color3.fromRGB(138, 43, 226)
                        tracerPart.Parent = char
                    end
                    
                    local p2 = hrp.Position
                    local distance = (p1 - p2).Magnitude
                    
                    tracerPart.Size = Vector3.new(0.03, 0.03, distance)
                    tracerPart.CFrame = CFrame.new(p1, p2) * CFrame.new(0, 0, -distance / 2)
                    tracerPart.Transparency = 0.3
                else
                    if tracerPart then
                        tracerPart:Destroy()
                    end
                end
            end
        end
    end)
end)

