-- Bucle de Armas (SkinChanger, Diseños y Mods)
task.spawn(function()
    while task.wait(0.6) do
        pcall(function()
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            local patterns = {
                ["Galaxy"] = { c = Color3.fromRGB(138, 43, 226), m = Enum.Material.ForceField },
                ["Camo"] = { c = Color3.fromRGB(85, 95, 60), m = Enum.Material.SmoothPlastic },
                ["Carbon Fiber"] = { c = Color3.fromRGB(40, 40, 40), m = Enum.Material.Glass },
                ["Lava"] = { c = Color3.fromRGB(255, 69, 0), m = Enum.Material.Neon },
                ["Lightning"] = { c = Color3.fromRGB(0, 206, 209), m = Enum.Material.Neon }
            }

            local function applyToContainer(cont)
                if not cont then return end
                for _, item in ipairs(cont:GetChildren()) do
                    if item:IsA("Tool") then
                        if getgenv().InfAmmoEnabled or getgenv().RapidFireEnabled then
                            for _, desc in ipairs(item:GetDescendants()) do
                                if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                                    local name = desc.Name:lower()
                                    if getgenv().RapidFireEnabled and (name:find("cooldown") or name:find("firerate")) then desc.Value = 0.01 end
                                    if getgenv().InfAmmoEnabled and (name:find("ammo") or name:find("clip")) then desc.Value = 999 end
                                end
                            end
                        end

                        if not originalWeaponStates[item] then
                            originalWeaponStates[item] = {}
                            for _, part in ipairs(item:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    originalWeaponStates[item][part] = { Color = part.Color, Material = part.Material }
                                end
                            end
                        end

                        if getgenv().SkinPatternEnabled then
                            local pat = patterns[getgenv().SelectedWeaponPattern] or patterns["Galaxy"]
                            for _, part in ipairs(item:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    if part:IsA("MeshPart") then part.TextureID = "" end
                                    part.Color = pat.c
                                    part.Material = pat.m
                                end
                            end
                        elseif getgenv().SkinChangerEnabled then
                            local colors = {
                                ["Gold"] = Color3.fromRGB(255, 215, 0), ["Diamond"] = Color3.fromRGB(185, 242, 255),
                                ["Ruby"] = Color3.fromRGB(224, 17, 95), ["Emerald"] = Color3.fromRGB(80, 200, 120),
                                ["Obsidian"] = Color3.fromRGB(30, 30, 30), ["Rainbow"] = Color3.fromRGB(math.random(0,255), math.random(0,255), math.random(0,255)),
                                ["Amethyst"] = Color3.fromRGB(153, 102, 204), ["Sapphire"] = Color3.fromRGB(15, 82, 186)
                            }
                            local col = colors[getgenv().SelectedWeaponSkin] or colors["Gold"]
                            local mat = Enum.Material[getgenv().SelectedWeaponMaterial] or Enum.Material.Neon
                            for _, part in ipairs(item:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    if part:IsA("MeshPart") then part.TextureID = "" end
                                    part.Color = col
                                    part.Material = mat
                                end
                            end
                        else
                            if originalWeaponStates[item] then
                                for part, data in pairs(originalWeaponStates[item]) do
                                    if part and part.Parent then
                                        part.Color = data.Color
                                        part.Material = data.Material
                                    end
                                end
                            end
                        end
                    end
                end
            end

            applyToContainer(char)
            applyToContainer(bp)
        end)
    end
end)
