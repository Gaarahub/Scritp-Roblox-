-- ================================================================
-- SELECTOR DE COLOR
-- ================================================================

TabVisuales:CreateDropdown({
   Name = "Color de Hitbox y ESP",

   Options = {
      "Azul Eléctrico",
      "Rojo Sangre",
      "Verde Tóxico",
      "Morado Psicodélico"
   },

   CurrentOption = {"Azul Eléctrico"},
   Flag = "ColorDropdown",

   Callback = function(Option)

      if type(Option) == "table" then
          Option = Option[1]
      end

      if Option == "Azul Eléctrico" then

          Config.HitboxColor = Color3.fromRGB(0, 150, 255)

      elseif Option == "Rojo Sangre" then

          Config.HitboxColor = Color3.fromRGB(255, 0, 0)

      elseif Option == "Verde Tóxico" then

          Config.HitboxColor = Color3.fromRGB(50, 255, 50)

      elseif Option == "Morado Psicodélico" then

          Config.HitboxColor = Color3.fromRGB(180, 0, 255)

      end

      for _, player in ipairs(Players:GetPlayers()) do

          if player ~= LocalPlayer and player.Character then

              pcall(function()

                  local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                  local hl = player.Character:FindFirstChild("Rayfield_Highlight")

                  if hrp and Config.HitboxEnabled then
                      hrp.Color = Config.HitboxColor
                  end

                  if hl then
                      hl.FillColor = Config.HitboxColor
                      hl.OutlineColor = Config.HitboxColor
                  end

              end)
          end
      end
   end,
})

