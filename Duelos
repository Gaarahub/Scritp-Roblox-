TabCombate:CreateToggle({
   Name = "Hitbox Gigante",
   CurrentValue = true,
   Flag = "HitboxToggle",

   Callback = function(Value)

      Config.HitboxEnabled = Value

      if not Value then

          for _, player in ipairs(Players:GetPlayers()) do

              if player ~= LocalPlayer and player.Character then

                  pcall(function()

                      local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                      local orig = originalSizes[player.Character]

                      if hrp and orig then
                          hrp.Size = orig
                          hrp.Transparency = 1
                          hrp.CanCollide = true
                      end

                  end)
              end
          end
      end
   end,
})

