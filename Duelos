local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local Config = {
    HitboxEnabled = true,
    HitboxSize = Vector3.new(15, 15, 15),
    HitboxTransparency = 0.1,
    HitboxColor = Color3.fromRGB(0, 150, 255),
    ESPEnabled = true,
    InfiniteJump = true,
    AntiCountdown = true
}

local originalSizes = {}

-- ================================================================
-- HITBOX LOOP
-- ================================================================

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            pcall(function()
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChild("Humanoid")

                if hrp and hum then
                    if hum.Health <= 0 then
                        if originalSizes[player.Character] then
                            hrp.Size = originalSizes[player.Character]
                            hrp.Transparency = 1
                            hrp.CanCollide = true
                        end
                        return
                    end

                    if not originalSizes[player.Character] then
                        originalSizes[player.Character] = hrp.Size
                    end

                    if Config.HitboxEnabled then
                        hrp.Size = Config.HitboxSize
                        hrp.Transparency = Config.HitboxTransparency
                        hrp.Color = Config.HitboxColor
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                    else
                        hrp.Size = originalSizes[player.Character] or Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.CanCollide = true
                    end
                end
            end)
        end
    end
end)

-- ================================================================
-- ANTI-CONTADOR
-- DETECTA EL CONTADOR AUNQUE NO TENGA TEXTO
-- "EL JUEGO COMIENZA EN..."
-- ================================================================

task.spawn(function()

    local previousValues = {}

    while task.wait(0.1) do

        if Config.AntiCountdown then

            pcall(function()

                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

                if not playerGui then
                    return
                end

                for _, gui in ipairs(playerGui:GetDescendants()) do

                    if gui:IsA("TextLabel")
                    or gui:IsA("TextButton")
                    or gui:IsA("TextBox") then

                        local text = tostring(gui.Text or "")
                        local lowerText = string.lower(text)

                        -- Nombre del objeto/interfaz
                        local objectName = string.lower(gui.Name or "")

                        -- Nombre de los padres
                        local parent = gui.Parent
                        local parentName = ""

                        if parent then
                            parentName = string.lower(parent.Name or "")
                        end

                        -- Buscar palabras relacionadas con contador
                        local countdownName =
                            objectName:find("countdown")
                            or objectName:find("timer")
                            or objectName:find("count")
                            or objectName:find("start")
                            or objectName:find("round")
                            or objectName:find("match")
                            or parentName:find("countdown")
                            or parentName:find("timer")
                            or parentName:find("count")
                            or parentName:find("start")
                            or parentName:find("round")
                            or parentName:find("match")

                        -- Frases conocidas
                        local countdownText =
                            lowerText:find("comienza")
                            or lowerText:find("comenzando")
                            or lowerText:find("comenzara")
                            or lowerText:find("comenzará")
                            or lowerText:find("empieza")
                            or lowerText:find("inicia")
                            or lowerText:find("starting")
                            or lowerText:find("starts in")
                            or lowerText:find("start in")
                            or lowerText:find("waiting")
                            or lowerText:find("esperando")
                            or lowerText:find("countdown")

                        -- Detectar formatos de tiempo
                        local cleanText = text:gsub("%s+", "")

                        local isTime =
                            cleanText:match("^%d+:%d+$") ~= nil
                            or cleanText:match("^%d+:%d+:%d+$") ~= nil

                        -- Detectar números pequeños usados normalmente
                        -- en cuentas regresivas.
                        local numberValue = tonumber(cleanText)

                        local isSmallNumber =
                            numberValue ~= nil
                            and numberValue >= 0
                            and numberValue <= 60

                        -- Comprobar si el valor está cambiando.
                        local oldValue = previousValues[gui]
                        local valueChanged = oldValue ~= nil and oldValue ~= text

                        previousValues[gui] = text

                        -- ====================================================
                        -- DECISIÓN
                        -- ====================================================

                        local shouldHide = false

                        -- Si el propio nombre indica que es contador
                        if countdownName then
                            shouldHide = true
                        end

                        -- Si contiene una frase de inicio
                        if countdownText then
                            shouldHide = true
                        end

                        -- Si es formato 00:10 / 0:10 y está cambiando
                        if isTime and valueChanged then
                            shouldHide = true
                        end

                        -- Si es un número pequeño que está cambiando
                        -- y pertenece a una interfaz relacionada con partida.
                        if isSmallNumber
                        and valueChanged
                        and countdownName then
                            shouldHide = true
                        end

                        if shouldHide then
                            gui.Visible = false
                        end

                    end
                end
            end)
        end
    end
end)

-- ================================================================
-- SALTO INFINITO
-- ================================================================

UserInputService.JumpRequest:Connect(function()

    if Config.InfiniteJump then

        pcall(function()

            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end

        end)
    end
end)

-- ================================================================
-- ESP
-- ================================================================

RunService.RenderStepped:Connect(function()

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            pcall(function()

                local char = player.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hl = char:FindFirstChild("Rayfield_Highlight")

                if Config.ESPEnabled and hum and hum.Health > 0 then

                    if not hl then

                        hl = Instance.new("Highlight")
                        hl.Name = "Rayfield_Highlight"
                        hl.Adornee = char
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char

                    end

                    hl.FillColor = Config.HitboxColor
                    hl.OutlineColor = Config.HitboxColor
                    hl.Enabled = true

                elseif hl then

                    hl.Enabled = false

                end
            end)
        end
    end
end)

