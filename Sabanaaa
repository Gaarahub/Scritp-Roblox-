                        distText.TextColor3 = Color3.fromRGB(60, 255, 255)
                        distText.Font = Enum.Font.GothamBold
                        distText.TextSize = 13
                        
                        espData[obj] = { Highlight = hl, Billboard = bgui, HP = hpText, Dist = distText, Hum = hum, Root = root }
                    else
