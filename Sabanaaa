                        local currentHP = math.floor(data.Hum.Health)
                        data.HP.Text = "❤️ " .. currentHP
                        
                        if currentHP < 200 then
                            data.Highlight.FillColor = Color3.fromRGB(255, 220, 0)
                        else
                            data.Highlight.FillColor = Color3.fromRGB(255, 50, 50)
                        end
                        
                        if myRoot then
                            data.Dist.Text = "📏 " .. math.floor((myRoot.Position - data.Root.Position).Magnitude / 3) .. "m"
                        end
                    end
                elseif hum.Health <= 0 and espData[obj] then
                    espData[obj].Highlight:Destroy()
                    espData[obj].Billboard:Destroy()
                    espData[obj] = nil
                end
            end
        end
    end
end)
