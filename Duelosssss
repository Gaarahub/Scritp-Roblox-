local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- CONFIGURACIÓN DE LA HITBOX (¡NO SE TOCA NADA DE AQUÍ!)
local HitboxConfig = {
    Size = Vector3.new(15, 15, 15),
    Transparency = 0.5,
    Color = Color3.fromRGB(255, 0, 0),
    Material = Enum.Material.Neon,
    Enabled = true
}

local function ExpandHitbox(character)
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if humanoidRootPart and humanoid then
        if humanoidRootPart:GetAttribute("HitboxExpanded") then return end
        humanoidRootPart:SetAttribute("HitboxExpanded", true)
        
        humanoidRootPart.Size = HitboxConfig.Size
        humanoidRootPart.Transparency = HitboxConfig.Transparency
        humanoidRootPart.Color = HitboxConfig.Color
        humanoidRootPart.Material = HitboxConfig.Material
        humanoidRootPart.CanCollide = false
    end
end

RunService.RenderStepped:Connect(function()
    if not HitboxConfig.Enabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            pcall(function()
                ExpandHitbox(player.Character)
            end)
        end
    end
end)

