local HitboxConfig = {
    Size = Vector3.new(15, 15, 15),
    Transparency = 0.1,
    Color = Color3.fromRGB(0, 150, 255),
    Material = Enum.Material.Neon,
    Enabled = true
}

local originalSizes = {}

local function ExpandHitbox(character)
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if humanoidRootPart and humanoid then
        -- Si está muerto, le quitamos la hitbox y restauramos su tamaño real
        if humanoid.Health <= 0 then
            local origSize = originalSizes[character]
            if origSize and humanoidRootPart.Size ~= origSize then
                humanoidRootPart.Size = origSize
                humanoidRootPart.Transparency = 1
                humanoidRootPart.CanCollide = true
            end
            return
        end
        
        if not originalSizes[character] then
            originalSizes[character] = humanoidRootPart.Size
        end
        
        if HitboxConfig.Enabled then
            humanoidRootPart.Size = HitboxConfig.Size
            humanoidRootPart.Transparency = HitboxConfig.Transparency
            humanoidRootPart.Color = HitboxConfig.Color
            humanoidRootPart.Material = HitboxConfig.Material
            humanoidRootPart.CanCollide = false
        else
            local origSize = originalSizes[character] or Vector3.new(2, 2, 1)
            humanoidRootPart.Size = origSize
            humanoidRootPart.Transparency = 1
            humanoidRootPart.CanCollide = true
        end
    end
end

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            pcall(function()
                ExpandHitbox(player.Character)
            end)
        end
    end
end)

